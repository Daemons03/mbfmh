{
    "name": "maxime/ferme-tranquille",
    "description": "Ferme Tranquille - jeu de ferme personnel, solo, dans le navigateur.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "FermeTranquille\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FermeTranquille\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:e2e": ".venv/bin/python -m pytest tests/e2e -q -p no:cacheprovider"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
